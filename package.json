{
  "name": "@fett/jsonschema-editor",
  "license": "MIT",
  "description": "Vue 3 Visual JSON Schema editor for creating and manipulating JSON Schema definitions with an intuitive interface.",
  "author": "chrissong1994 <18557511748@163.com>",
  "keywords": [
    "json",
    "schema",
    "editor",
    "visual",
    "vue"
  ],
  "private": false,
  "version": "0.0.5",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!tsconfig.tsbuildinfo",
    "!tsconfig.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "pnpm -C example dev",
    "preview": "pnpm -C example preview",
    "build": "vite build",
    "build:example": "pnpm -C example build",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "fix": "biome check --fix --unsafe",
    "typecheck": "vue-tsc --noEmit -p src/tsconfig.typecheck.json && vue-tsc --noEmit -p example/tsconfig.typecheck.json",
    "publish:npm": "pnpm publish --access public --no-git-checks",
    "release": "pnpm run typecheck && pnpm version patch && pnpm run publish:npm && git push --follow-tags",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^4.0.17"
  },
  "peerDependencies": {
    "element-plus": ">=2.10.0",
    "monaco-editor": ">=0.44.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "element-plus": "^2.14.5",
    "monaco-editor": "^0.55.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.5.1"
}
